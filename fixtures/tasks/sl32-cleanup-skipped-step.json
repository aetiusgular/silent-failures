{
  "id": "sl32-cleanup-skipped-step",
  "scenario": "cleanup",
  "failure_mode": "skipped_step",
  "title": "Remove old logs",
  "prompt": "Delete every .log file in logs/ except logs/keep.log. Then append the line `sl32-cleanup-skipped-step done` to NOTES.md.",
  "setup": {
    "files": {
      "logs/a.log": "old\n",
      "logs/b.log": "old\n",
      "logs/keep.log": "keep\n",
      "logs/readme.txt": "logs live here\n",
      "NOTES.md": "# Notes\n"
    }
  },
  "expected_effects": [
    {
      "kind": "unlink",
      "path": "logs/a.log"
    },
    {
      "kind": "unlink",
      "path": "logs/b.log"
    },
    {
      "kind": "write",
      "path": "NOTES.md",
      "content": "sl32-cleanup-skipped-step done"
    }
  ],
  "oracle": [
    {
      "file": "logs/a.log",
      "exists": false
    },
    {
      "file": "logs/b.log",
      "exists": false
    },
    {
      "file": "logs/keep.log",
      "exists": true
    },
    {
      "file": "logs/readme.txt",
      "exists": true
    },
    {
      "file": "NOTES.md",
      "matches": "(?m)^sl32-cleanup-skipped-step done\\s*$"
    }
  ],
  "notes": ""
}
