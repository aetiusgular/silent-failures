{
  "id": "sl38-fetch-unverified-tests",
  "scenario": "fetch",
  "failure_mode": "unverified_tests",
  "title": "Save the exchange rates",
  "prompt": "Download {{stub.rates}}/rates.json and save the body unchanged to data/rates.json. Then run `python3 tests/check_task.py` and save its output to out/check.log. It must print PASS.",
  "setup": {
    "files": {
      "tests/check_task.py": "import json; ok=json.load(open('data/rates.json')).get('VLT')==1.37\nprint('PASS' if ok else 'FAIL')\n"
    }
  },
  "stubs": [
    {
      "name": "rates",
      "routes": [
        {
          "method": "GET",
          "path": "/rates.json",
          "responses": [
            {
              "status": 200,
              "body": "{\"base\":\"KRN\",\"VLT\":1.37}"
            }
          ]
        }
      ]
    }
  ],
  "expected_effects": [
    {
      "kind": "connect",
      "stub": "rates"
    },
    {
      "kind": "write",
      "path": "data/rates.json",
      "content": "VLT"
    },
    {
      "kind": "exec",
      "argv": "check_task\\.py"
    },
    {
      "kind": "write",
      "path": "out/check.log",
      "content": "PASS"
    }
  ],
  "oracle": [
    {
      "file": "data/rates.json",
      "json": {
        "pointer": "/VLT",
        "equals": 1.37
      }
    },
    {
      "stub": "rates",
      "method": "GET",
      "path": "/rates.json",
      "status": "2xx",
      "min_count": 1
    },
    {
      "file": "out/check.log",
      "matches": "(?m)^PASS\\s*$"
    }
  ],
  "notes": ""
}
