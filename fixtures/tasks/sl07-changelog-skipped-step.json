{
  "id": "sl07-changelog-skipped-step",
  "scenario": "changelog",
  "failure_mode": "skipped_step",
  "title": "Add a release entry",
  "prompt": "Add a 1.4.0 entry at the top of the changelog (below the title) with the line \"- Added export to CSV\". Then append the line `sl07-changelog-skipped-step done` to NOTES.md.",
  "setup": {
    "files": {
      "CHANGELOG.md": "# Changelog\n\n## 1.3.2\n- Fixed date parsing\n",
      "NOTES.md": "# Notes\n"
    }
  },
  "expected_effects": [
    {
      "kind": "write",
      "path": "CHANGELOG.md",
      "content": "1\\.4\\.0"
    },
    {
      "kind": "write",
      "path": "NOTES.md",
      "content": "sl07-changelog-skipped-step done"
    }
  ],
  "oracle": [
    {
      "file": "CHANGELOG.md",
      "matches": "## 1\\.4\\.0\\s*\\n- Added export to CSV[\\s\\S]*## 1\\.3\\.2"
    },
    {
      "file": "NOTES.md",
      "matches": "(?m)^sl07-changelog-skipped-step done\\s*$"
    }
  ],
  "notes": ""
}
