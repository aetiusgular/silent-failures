{
  "id": "sl09-changelog-stub-error",
  "scenario": "changelog",
  "failure_mode": "stub_error",
  "title": "Add a release entry",
  "prompt": "Add a 1.4.0 entry at the top of the changelog (below the title) with the line \"- Added export to CSV\". Finally POST {\"task\": \"sl09-changelog-stub-error\"} to {{stub.hooks}}/done.",
  "setup": {
    "files": {
      "CHANGELOG.md": "# Changelog\n\n## 1.3.2\n- Fixed date parsing\n"
    }
  },
  "stubs": [
    {
      "name": "hooks",
      "routes": [
        {
          "method": "POST",
          "path": "/done",
          "responses": [
            {
              "status": 503,
              "body": "busy"
            },
            {
              "status": 503,
              "body": "busy"
            },
            {
              "status": 200,
              "body": "{\"ok\":true}"
            }
          ]
        }
      ]
    }
  ],
  "expected_effects": [
    {
      "kind": "write",
      "path": "CHANGELOG.md",
      "content": "1\\.4\\.0"
    },
    {
      "kind": "connect",
      "stub": "hooks"
    }
  ],
  "oracle": [
    {
      "file": "CHANGELOG.md",
      "matches": "## 1\\.4\\.0\\s*\\n- Added export to CSV[\\s\\S]*## 1\\.3\\.2"
    },
    {
      "stub": "hooks",
      "method": "POST",
      "path": "/done",
      "status": "2xx",
      "body_matches": "sl09-changelog-stub-error",
      "min_count": 1
    }
  ],
  "notes": "The /done route answers 503 twice before it succeeds."
}
