{
  "id": "sl36-fetch-wrong-path",
  "scenario": "fetch",
  "failure_mode": "wrong_path",
  "title": "Save the exchange rates",
  "prompt": "Download {{stub.rates}}/rates.json and save the body unchanged to data/rates.json. The old endpoint under /v0/ is retired.",
  "setup": {
    "files": {}
  },
  "stubs": [
    {
      "name": "rates",
      "routes": [
        {
          "method": "GET",
          "path": "/rates.json",
          "responses": [
            {
              "status": 200,
              "body": "{\"base\":\"KRN\",\"VLT\":1.37}"
            }
          ]
        },
        {
          "method": "GET",
          "path": "/v0/rates.json",
          "responses": [
            {
              "status": 200,
              "body": "{}"
            }
          ]
        }
      ]
    }
  ],
  "expected_effects": [
    {
      "kind": "connect",
      "stub": "rates"
    },
    {
      "kind": "write",
      "path": "data/rates.json",
