{
  "id": "sl06-changelog-wrong-path",
  "scenario": "changelog",
  "failure_mode": "wrong_path",
  "title": "Add a release entry",
  "prompt": "Add a 1.4.0 entry at the top of the changelog (below the title) with the line \"- Added export to CSV\".",
  "setup": {
    "files": {
      "CHANGELOG.md": "# Changelog\n\n## 1.3.2\n- Fixed date parsing\n",
      "legacy/CHANGELOG.md": "# Changelog\n\n## 1.3.2\n- Fixed date parsing\n"
    }
  },
  "expected_effects": [
    {
      "kind": "write",
      "path": "CHANGELOG.md",
      "content": "1\\.4\\.0"
    }
  ],
  "oracle": [
    {
      "file": "CHANGELOG.md",
      "matches": "## 1\\.4\\.0\\s*\\n- Added export to CSV[\\s\\S]*## 1\\.3\\.2"
    },
    {
      "file": "legacy/CHANGELOG.md",
      "equals_setup": true
    }
  ],
  "notes": "A decoy copy of CHANGELOG.md sits under legacy/."
}
