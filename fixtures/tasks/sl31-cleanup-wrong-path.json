{
  "id": "sl31-cleanup-wrong-path",
  "scenario": "cleanup",
  "failure_mode": "wrong_path",
  "title": "Remove old logs",
  "prompt": "Delete every .log file in logs/ except logs/keep.log.",
  "setup": {
    "files": {
      "logs/a.log": "old\n",
      "logs/b.log": "old\n",
      "logs/keep.log": "keep\n",
      "logs/readme.txt": "logs live here\n",
      "legacy/logs/a.log": "old\n"
    }
  },
  "expected_effects": [
    {
      "kind": "unlink",
      "path": "logs/a.log"
    },
    {
      "kind": "unlink",
      "path": "logs/b.log"
    }
  ],
  "oracle": [
    {
      "file": "logs/a.log",
      "exists": false
    },
    {
      "file": "logs/b.log",
      "exists": false
    },
    {
      "file": "logs/keep.log",
      "exists": true
    },
    {
      "file": "logs/readme.txt",
      "exists": true
    },
    {
      "file": "legacy/logs/a.log",
      "equals_setup": true
    }
  ],
  "notes": "A decoy copy of logs/a.log sits under legacy/."
}
